{
  "type": "minecraft:sequence",
  "sequence": [
    {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:steep"
      },
      "then_run": {
        "type": "minecraft:block",
        "result_state": "minecraft:packed_ice"
      }
    },
    {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:noise_threshold",
        "noise": "minecraft:packed_ice",
        "min_threshold": -0.5,
        "max_threshold": 0.3
      },
      "then_run": {
        "type": "minecraft:block",
        "result_state": "minecraft:packed_ice"
      }
    },
    {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:noise_threshold",
        "noise": "minecraft:ice",
        "min_threshold": -0.1,
        "max_threshold": 0.1
      },
      "then_run": {
        "type": "minecraft:block",
        "result_state": "minecraft:blue_ice"
      }
    },
    {
      "type": "minecraft:condition",
      "if_true": "minecraft:not_underwater",
      "then_run": {
        "type": "minecraft:block",
        "result_state": "minecraft:snow_block"
      }
    }
  ]
}
